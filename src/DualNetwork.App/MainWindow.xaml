<Window x:Class="DualNetwork.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DualNetwork.App"
        Title="Dual Network" Width="1140" Height="800" MinWidth="900" MinHeight="620"
        Background="{StaticResource WindowBg}" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- Primary button turns into a red "Disable" button while active -->
        <Style x:Key="ModeButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="0,11" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="White" />
                    <Setter Property="Foreground" Value="{StaticResource Bad}" />
                    <Setter Property="BorderBrush" Value="#FCA5A5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="DotTemplate">
            <Ellipse Width="10" Height="10" Fill="{Binding Converter={StaticResource SeverityBrush}}" VerticalAlignment="Center" />
        </DataTemplate>

        <!-- Round status glyph (✓ ! ✕ i) -->
        <DataTemplate x:Key="GlyphTemplate">
            <Border Width="20" Height="20" CornerRadius="10" Background="{Binding Converter={StaticResource SeverityBrush}}" VerticalAlignment="Top">
                <TextBlock Text="{Binding Converter={StaticResource SeverityGlyph}}" Foreground="White" FontSize="11" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================== Header -->
        <Border Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource Accent}">
                    <Grid>
                        <TextBlock Text="&#xE839;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="White" Margin="6,6,0,0" />
                        <TextBlock Text="&#xE701;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="White" Margin="0,0,6,6"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Dual Network" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock Text="Client Network + Internet" Style="{StaticResource Muted}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LastUpdated}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <Border Style="{StaticResource Pill}" Margin="0,0,10,0" Padding="10,4">
                        <TextBlock Text="{Binding ElevationText}" FontSize="12" Foreground="{StaticResource Accent}" />
                    </Border>
                    <Button Content="{Binding CableButtonText}" Command="{Binding ToggleCableCommand}" Margin="0,0,8,0"
                            Visibility="{Binding IsDemo, Converter={StaticResource BoolToVis}}" />
                    <Button Content="Restart as Administrator" Command="{Binding RestartAsAdminCommand}" Margin="0,0,8,0"
                            Visibility="{Binding IsElevated, Converter={StaticResource InverseBoolToVis}}" />
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="20,8,20,0">

            <!-- ============================== Overview -->
            <TabItem Header="Overview">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,14,0,0">
                    <Grid Margin="4,0,4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="390" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <!-- Mode card -->
                            <Border Style="{StaticResource Card}" Padding="24,20">
                                <StackPanel>
                                    <TextBlock Text="DUAL NETWORK MODE" Style="{StaticResource SectionTitle}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Ellipse Width="16" Height="16" Fill="{Binding ModeSeverity, Converter={StaticResource SeverityBrush}}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ModeTitle}" FontSize="26" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock FontSize="14" Margin="0,0,0,3">
                                        <Run Text="&#xE839;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource TextMuted}" />
                                        <Run Text="  " /><Run Text="{Binding ClientRoleLine, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock FontSize="14">
                                        <Run Text="&#xE701;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource TextMuted}" />
                                        <Run Text="  " /><Run Text="{Binding InternetRoleLine, Mode=OneWay}" />
                                    </TextBlock>

                                    <Border Margin="0,16,0,0" Padding="12,9" CornerRadius="7"
                                            Background="{Binding ModeDetailSeverity, Converter={StaticResource SeveritySoftBrush}}">
                                        <TextBlock Text="{Binding ModeDetail}" TextWrapping="Wrap" FontSize="12.5" />
                                    </Border>

                                    <StackPanel Margin="0,14,0,0" Visibility="{Binding BothHaveInternet, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Both networks have Internet. Use for Internet traffic:" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Content="Wi-Fi" GroupName="pref" IsChecked="{Binding PreferWiFiInternet, Mode=OneWay}" Click="PreferWiFi_Click" />
                                            <RadioButton Content="Client network" GroupName="pref" IsChecked="{Binding PreferClientInternet, Mode=OneWay}" Click="PreferClient_Click" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Button Margin="0,18,0,0" Style="{StaticResource ModeButton}" Command="{Binding PrimaryCommand}"
                                            Content="{Binding PrimaryButtonText}"
                                            Visibility="{Binding IsLeftovers, Converter={StaticResource InverseBoolToVis}}" />
                                    <Button Style="{StaticResource LinkButton}" Command="{Binding ViewChangesCommand}" HorizontalAlignment="Center" Margin="0,12,0,0"
                                            Content="What does Dual Network change, and why?" />
                                    <Grid Margin="0,18,0,0" Visibility="{Binding IsLeftovers, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Button Content="Resume monitoring" Command="{Binding ResumeCommand}" Style="{StaticResource PrimaryButton}" />
                                        <Button Grid.Column="2" Content="Restore original" Command="{Binding RestoreCommand}" Style="{StaticResource DangerButton}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Routing status -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="ROUTING STATUS (LIVE, FROM WINDOWS)" Style="{StaticResource SectionTitle}" />
                                    <ItemsControl ItemsSource="{Binding RoutingLines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20" />
                                                        <ColumnDefinition Width="130" />
                                                        <ColumnDefinition Width="22" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <ContentPresenter Content="{Binding Severity}" ContentTemplate="{StaticResource DotTemplate}" HorizontalAlignment="Left" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="2" Text="→" Foreground="{StaticResource TextMuted}" />
                                                    <StackPanel Grid.Column="3">
                                                        <TextBlock Text="{Binding Target}" FontSize="13.5" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Hint}" Style="{StaticResource Muted}" FontSize="11.5"
                                                                   Visibility="{Binding Hint, Converter={StaticResource EmptyToCollapsed}}" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- DNS -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="DNS" Style="{StaticResource SectionTitle}" />
                                    <ItemsControl ItemsSource="{Binding DnsGroups}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,12">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" />
                                                    <TextBlock Text="{Binding Servers}" Style="{StaticResource Mono}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Note}" Style="{StaticResource Muted}" FontSize="11.5"
                                                               Visibility="{Binding Note, Converter={StaticResource EmptyToCollapsed}}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <!-- Notices -->
                            <Border Style="{StaticResource Card}" Visibility="{Binding Notices.Count, Converter={StaticResource EmptyToCollapsed}}">
                                <ItemsControl ItemsSource="{Binding Notices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,3" Padding="10,8" CornerRadius="7" Background="{Binding Severity, Converter={StaticResource SeveritySoftBrush}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="30" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <ContentPresenter Content="{Binding Severity}" ContentTemplate="{StaticResource GlyphTemplate}" HorizontalAlignment="Left" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="12.5" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <!-- Interfaces -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,4">
                                        <CheckBox DockPanel.Dock="Right" Content="Show disconnected adapters" IsChecked="{Binding ShowAllAdapters}" Margin="0" FontSize="12" />
                                        <TextBlock Text="NETWORK INTERFACES" Style="{StaticResource SectionTitle}" />
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding Adapters}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,10">
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding KindText}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                                            <StackPanel Orientation="Horizontal">
                                                                <ContentPresenter Content="{Binding Severity}" ContentTemplate="{StaticResource DotTemplate}" />
                                                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                                <Border Style="{StaticResource Pill}" Visibility="{Binding Role, Converter={StaticResource EmptyToCollapsed}}">
                                                                    <TextBlock Text="{Binding Role}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                                                                </Border>
                                                            </StackPanel>
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding StatusLine}" Style="{StaticResource Muted}" Margin="20,3,0,0" />
                                                        <TextBlock Text="{Binding Address}" FontSize="14" Margin="20,4,0,6"
                                                                   Visibility="{Binding Address, Converter={StaticResource EmptyToCollapsed}}" />
                                                        <ItemsControl ItemsSource="{Binding Details}" Margin="20,0,0,0">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <UniformGrid Columns="2" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Margin="0,1,12,1" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}">
                                                                        <Run Text="{Binding Label, Mode=OneWay}" Foreground="{StaticResource TextMuted}" />
                                                                        <Run Text="  " /><Run Text="{Binding Value, Mode=OneWay}" />
                                                                    </TextBlock>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Preserved -->
                            <Border Style="{StaticResource Card}" Visibility="{Binding Preserved.Count, Converter={StaticResource EmptyToCollapsed}}">
                                <Expander Header="Client routes and settings that are preserved (never modified)" FontSize="13">
                                    <ItemsControl ItemsSource="{Binding Preserved}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Style="{StaticResource Mono}" Margin="0,2" TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ============================== Diagnostics -->
            <TabItem Header="Diagnostics">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,14,0,0">
                    <Grid Margin="4,0,4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="390" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="NETWORK STATUS" Style="{StaticResource SectionTitle}" />
                                <ItemsControl ItemsSource="{Binding StatusSections}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,14">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4" />
                                                <ItemsControl ItemsSource="{Binding Items}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                                <TextBlock Text="{Binding Severity, Converter={StaticResource SeverityGlyph}}" Width="16" FontWeight="Bold"
                                                                           Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                                                <TextBlock Text="{Binding Text}" FontSize="13" TextWrapping="Wrap" MaxWidth="320" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <Button DockPanel.Dock="Right" Content="Run Network Test" Command="{Binding RunTestCommand}" Style="{StaticResource PrimaryButton}" />
                                    <StackPanel>
                                        <TextBlock Text="NETWORK TEST" Style="{StaticResource SectionTitle}" Margin="0,0,0,2" />
                                        <TextBlock Text="{Binding TestSummary}" Style="{StaticResource Muted}" />
                                    </StackPanel>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding TestResults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Content="{Binding Status}" ContentTemplate="{StaticResource GlyphTemplate}" HorizontalAlignment="Left" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Card}"
                                Visibility="{Binding ShowAdvanced, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="IPV4 ROUTING TABLE (ADVANCED) — rows marked ★ were added by Dual Network" Style="{StaticResource SectionTitle}" />
                                <DataGrid ItemsSource="{Binding RouteRows}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource CardBorder}" BorderThickness="0"
                                          Background="White" RowBackground="White" FontFamily="{StaticResource MonoFont}" FontSize="12" MaxHeight="420">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="" Width="24">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="★" Foreground="{StaticResource Accent}" Visibility="{Binding IsOurs, Converter={StaticResource BoolToVis}}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="160" />
                                        <DataGridTextColumn Header="Next hop" Binding="{Binding NextHop}" Width="140" />
                                        <DataGridTextColumn Header="Interface" Binding="{Binding Interface}" Width="*" />
                                        <DataGridTextColumn Header="Route metric" Binding="{Binding Metric}" Width="100" />
                                        <DataGridTextColumn Header="If metric" Binding="{Binding InterfaceMetric}" Width="80" />
                                        <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="110" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ============================== Log -->
            <TabItem Header="Log">
                <Border Style="{StaticResource Card}" Margin="4,14,4,16" Padding="0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1" Padding="16,10">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="Copy" Command="{Binding CopyLogCommand}" Margin="0,0,8,0" />
                                    <Button Content="Open log folder" Command="{Binding OpenLogFolderCommand}" Margin="0,0,8,0" />
                                    <Button Content="Clear view" Command="{Binding ClearLogCommand}" />
                                </StackPanel>
                                <CheckBox Content="Show decision details (routing trace)" IsChecked="{Binding ShowLogDetails}" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <ListBox x:Name="LogList" ItemsSource="{Binding VisibleLog}" BorderThickness="0" Padding="8,6"
                                 VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Time, StringFormat=HH:mm:ss}" Style="{StaticResource Mono}" Foreground="{StaticResource TextSubtle}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Message}" Style="{StaticResource Mono}" TextWrapping="Wrap"
                                                   Foreground="{Binding Level, Converter={StaticResource LogBrush}}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ============================== Settings -->
            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,14,0,0">
                    <StackPanel Margin="4,0,4,8" MaxWidth="820" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="STARTUP AND NOTIFICATIONS" Style="{StaticResource SectionTitle}" />
                                <CheckBox Content="Start Dual Network automatically when I sign in to Windows (runs in the notification area, no prompt)" IsChecked="{Binding StartWithWindows}" />
                                <CheckBox Content="Show a notification when Dual Network changes routing or needs attention" IsChecked="{Binding Notifications}" />
                                <TextBlock Style="{StaticResource Muted}" Margin="22,4,0,0"
                                           Text="Closing the window keeps Dual Network running in the notification area. To stop it, right-click the tray icon and choose Exit; your original configuration is restored." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="ADAPTER ROLES" Style="{StaticResource SectionTitle}" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                                           Text="Automatic picks the connected Wi-Fi for Internet and the wired Ethernet for the client network. VPN adapters are never used. Override only for special setups such as USB tethering or a USB Ethernet dongle." />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="300" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Internet adapter" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding AdapterNames}" SelectedItem="{Binding InternetAdapter}" Margin="0,4" />
                                    <TextBlock Grid.Row="1" Text="Client network adapter" VerticalAlignment="Center" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AdapterNames}" SelectedItem="{Binding ClientAdapter}" Margin="0,4" />
                                </Grid>
                                <TextBlock Text="When both networks have Internet, send Internet traffic through:" Margin="0,14,0,4" />
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="Wi-Fi (recommended)" GroupName="settingsPref" IsChecked="{Binding PreferWiFiInternet}" />
                                    <RadioButton Content="Client network" GroupName="settingsPref" IsChecked="{Binding PreferClientInternet}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="CLIENT NETWORKS" Style="{StaticResource SectionTitle}" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,8"
                                           Text="The directly connected client subnet always stays on Ethernet, and routes supplied by the client network are always preserved. When the client network has a gateway, Internet traffic is kept on Wi-Fi, so internal networks behind that gateway need their own routes:" />
                                <CheckBox Content="Route the private range that contains the Ethernet address (e.g. 10.0.0.0/8) via the client gateway" IsChecked="{Binding RouteContainingBlock}" />
                                <CheckBox Content="Route all private ranges (10/8, 172.16/12, 192.168/16) via the client gateway — your Wi-Fi LAN stays on Wi-Fi" IsChecked="{Binding RouteAllBlocks}" />
                                <TextBlock Text="Additional client networks (one per line, e.g. 100.64.10.0/24)" Margin="0,12,0,4" />
                                <TextBox Text="{Binding ExtraPrefixes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="70"
                                         VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource MonoFont}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="DNS" Style="{StaticResource SectionTitle}" />
                                <CheckBox Content="Split DNS: resolve internal domains with the client's DNS servers (Windows NRPT rules)" IsChecked="{Binding ManageDns}" />
                                <TextBlock Style="{StaticResource Muted}" Margin="22,0,0,8"
                                           Text="The DNS suffix provided by the client network is used automatically. DNS server settings of your adapters are never replaced." />
                                <TextBlock Text="Additional internal domains (one per line, e.g. corp.local)" Margin="0,4,0,4" />
                                <TextBox Text="{Binding InternalDomains, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="70"
                                         VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource MonoFont}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="ADVANCED" Style="{StaticResource SectionTitle}" />
                                <CheckBox Content="Advanced mode: show the exact Windows changes and the routing table" IsChecked="{Binding ShowAdvanced}" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Change journal" Style="{StaticResource Muted}" />
                                    <TextBlock Grid.Column="1" Text="{Binding JournalPath}" Style="{StaticResource Mono}" />
                                    <TextBlock Grid.Row="1" Text="Snapshots" Style="{StaticResource Muted}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SnapshotPath}" Style="{StaticResource Mono}" />
                                    <TextBlock Grid.Row="2" Text="Logs" Style="{StaticResource Muted}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LogPath}" Style="{StaticResource Mono}" />
                                </Grid>
                                <Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Save settings" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButton}" />
                            <Button Content="Discard changes" Command="{Binding ResetSettingsCommand}" Margin="10,0,0,0" />
                            <TextBlock Text="{Binding SettingsStatus}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
